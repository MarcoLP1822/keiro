        {
          "character": "そ",
          "romaji": "so"
        }
      ]
    },
    {
      "id": "hiragana-t",
      "name": "T-row: たちつてと",
      "type": "kana",
      "level": "beginner",
      "order": 1003,
      "intro": {
        "title": "The T Consonant Row",
        "explanation": "The T-row has two exceptions: ち is 'chi' and つ is 'tsu'. The つ sound is unique to Japanese and takes practice.",
        "cultureNote": null
      },
      "items": [
        {
          "character": "た",
          "romaji": "ta"
        },
        {
          "character": "ち",
          "romaji": "chi"
