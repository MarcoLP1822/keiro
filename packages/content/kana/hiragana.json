      "type": "kana",
      "level": "beginner",
      "order": 1009,
      "intro": {
        "title": "The W-row and N",
        "explanation": "The final group includes わ (wa), the particle を (wo, usually pronounced 'o'), and ん (n) — the only consonant that stands alone without a vowel.",
        "cultureNote": null
