        {
          "character": "て",
          "romaji": "te"
        },
        {
          "character": "と",
          "romaji": "to"
        }
      ]
    },
    {
      "id": "hiragana-n",
      "name": "N-row: なにぬねの",
      "type": "kana",
      "level": "beginner",
      "order": 1004,
      "intro": {
        "title": "The N Consonant Row",
        "explanation": "The N-row is completely regular — each character combines 'n' with a vowel. The character の is one of the most common in Japanese, used as a possessive particle.",
        "cultureNote": null
      },
      "items": [
        {
          "character": "な",
          "romaji": "na"
        },
        {
          "character": "に",
          "romaji": "ni"
        },
        {
          "character": "ぬ",
          "romaji": "nu"
        },
        {
          "character": "ね",
          "romaji": "ne"
        },
        {
          "character": "の",
          "romaji": "no"
        }
      ]
    },
    {
      "id": "hiragana-h",
      "name": "H-row: はひふへほ",
      "type": "kana",
      "level": "beginner",
      "order": 1005,
      "intro": {
        "title": "The H Consonant Row",
        "explanation": "The H-row has one exception: ふ is pronounced 'fu' (a soft sound between 'f' and 'h'). The character は is also used as the topic particle, where it's pronounced 'wa'.",
        "cultureNote": null
      },
      "items": [
        {
          "character": "は",
          "romaji": "ha"
        },
        {
          "character": "ひ",
          "romaji": "hi"
        },
        {
          "character": "ふ",
          "romaji": "fu"
        },
        {
          "character": "へ",
          "romaji": "he"
        },
        {
          "character": "ほ",
          "romaji": "ho"
        }
      ]
    },
    {
      "id": "hiragana-m",
      "name": "M-row: まみむめも",
      "type": "kana",
      "level": "beginner",
      "order": 1006,
      "intro": {
        "title": "The M Consonant Row",
        "explanation": "The M-row is completely regular. Each character combines 'm' with a vowel sound.",
        "cultureNote": null
      },
      "items": [
        {
          "character": "ま",
          "romaji": "ma"
