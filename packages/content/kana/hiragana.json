          "romaji": "ko"
        }
      ]
    },
    {
      "id": "hiragana-s",
      "name": "S-row: さしすせそ",
      "type": "kana",
      "level": "beginner",
      "order": 1002,
      "intro": {
        "title": "The S Consonant Row",
        "explanation": "The S-row has one exception: し is pronounced 'shi' rather than 'si'. This is one of the few irregular readings in hiragana.",
        "cultureNote": null
      },
      "items": [
        {
          "character": "さ",
          "romaji": "sa"
        },
        {
          "character": "し",
