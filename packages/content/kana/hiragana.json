      "name": "Y-row: やゆよ",
      "type": "kana",
      "level": "beginner",
      "order": 1007,
      "intro": {
        "title": "The Y Consonant Row",
        "explanation": "The Y-row has only 3 characters (yi and ye are not used in modern Japanese). These characters also combine with other consonants to form compound sounds.",
        "cultureNote": null
      },
      "items": [
