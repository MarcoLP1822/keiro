  "modules": [
    {
      "id": "hiragana-vowels",
      "name": "Vowels: あいうえお",
      "type": "kana",
      "level": "beginner",
      "order": 1000,
      "intro": {
        "title": "The 5 Vowels",
        "explanation": "Japanese has exactly 5 vowel sounds. Every other sound in Japanese is built from these.",
        "cultureNote": null
      },
      "items": [
        {
          "character": "あ",
          "romaji": "a"
        },
        {
          "character": "い",
          "romaji": "i"
        },
        {
          "character": "う",
          "romaji": "u"
        },
        {
          "character": "え",
          "romaji": "e"
        },
        {
          "character": "お",
          "romaji": "o"
        }
      ]
    },
    {
      "id": "hiragana-k",
      "name": "K-row: かきくけこ",
      "type": "kana",
      "level": "beginner",
      "order": 1001,
      "intro": {
        "title": "The K Consonant Row",
        "explanation": "The K-row combines the 'k' consonant with each vowel. These are among the most common sounds in Japanese.",
        "cultureNote": null
      },
      "items": [
        {
          "character": "か",
          "romaji": "ka"
        },
