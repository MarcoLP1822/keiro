      "name": "R-row: らりるれろ",
      "type": "kana",
      "level": "beginner",
      "order": 1008,
      "intro": {
        "title": "The R Consonant Row",
        "explanation": "The Japanese 'r' sound is unlike English 'r' or 'l'. It's a light tap of the tongue against the roof of the mouth, similar to the 'd' in 'ladder'.",
        "cultureNote": null
      },
      "items": [
        {
          "character": "ら",
