        {
          "id": "theme-si-wo-benkyou",
          "title": "Xを勉強しています (X wo benkyou shite imasu)",
          "explanation": "を (wo/o) marks the direct object. 勉強しています (benkyou shite imasu) means 'am studying' — the て-form of a verb + います expresses an ongoing action.",
          "structure": "Noun + を + 勉強しています",
          "examples": [
            {
              "japanese": "日本語を勉強しています。",
              "english": "I am studying Japanese.",
              "furigana": [
