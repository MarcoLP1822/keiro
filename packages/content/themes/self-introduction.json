      "grammar": [
        {
          "id": "theme-si-wa-desu",
          "title": "XはYです (X wa Y desu)",
          "explanation": "The basic Japanese sentence pattern. は (wa) marks the topic, です (desu) acts as the copula meaning 'is/am/are'. This is the foundation of self-introduction sentences.",
          "structure": "Topic は + Noun/Adjective + です",
          "examples": [
            {
              "japanese": "私は学生です。",
              "english": "I am a student.",
              "furigana": [
                { "text": "私", "reading": "わたし" },
                { "text": "は", "reading": null },
                { "text": "学生", "reading": "がくせい" },
                { "text": "です", "reading": null },
                { "text": "。", "reading": null }
              ]
            },
            {
              "japanese": "私は会社員です。",
              "english": "I am an office worker.",
              "furigana": [
                { "text": "私", "reading": "わたし" },
                { "text": "は", "reading": null },
                { "text": "会社員", "reading": "かいしゃいん" },
                { "text": "です", "reading": null },
                { "text": "。", "reading": null }
              ]
            },
            {
              "japanese": "趣味は映画です。",
              "english": "My hobby is movies.",
              "furigana": [
                { "text": "趣味", "reading": "しゅみ" },
                { "text": "は", "reading": null },
                { "text": "映画", "reading": "えいが" },
                { "text": "です", "reading": null },
                { "text": "。", "reading": null }
              ]
            }
          ],
          "notes": "です is polite (丁寧語). In casual speech it is often dropped entirely."
        },
        {
          "id": "theme-si-no",
          "title": "XのY (X no Y)",
          "explanation": "の (no) connects two nouns, expressing possession, affiliation, or modification. It roughly corresponds to 'X's Y' or 'Y of X' in English.",
